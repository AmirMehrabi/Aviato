[Unit]
Description=Aviato disposable portal cache
After=network.target

[Service]
Type=notify
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/redis/portal.conf --supervised systemd --daemonize no
Restart=on-failure
RuntimeDirectory=redis-portal
StateDirectory=redis-portal
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/redis-portal /run/redis-portal
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
